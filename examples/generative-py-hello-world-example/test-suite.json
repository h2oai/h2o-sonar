{
    "name": "H2O.ai Company Overview Test Suite",
    "description": "Simple hello world test suite for evaluating RAG system responses about H2O.ai company information. Contains basic question-answering tests to verify RAG accuracy on factual queries about company background and agentic AI capabilities.",
    "tests": [
        {
            "key": "h2o-ai-overview-test",
            "documents": [
                "corpus-h2o-ai.txt"
            ],
            "test_cases": [
                {
                    "key": "founding-year",
                    "prompt": "When was H2O.ai founded?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O.ai was founded in 2012.",
                    "constraints": [
                        "2012"
                    ]
                },
                {
                    "key": "headquarters-location",
                    "prompt": "Where is H2O.ai headquartered?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O.ai is headquartered in Mountain View, California.",
                    "constraints": [
                        "Mountain View",
                        "California"
                    ]
                },
                {
                    "key": "company-mission",
                    "prompt": "What is H2O.ai's mission?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O.ai's mission is to democratize AI and make it accessible to everyone.",
                    "constraints": [
                        ["democratize", "accessible"],
                        "AI"
                    ]
                },
                {
                    "key": "agentic-ai-platform",
                    "prompt": "What agentic AI platform has H2O.ai developed?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O.ai has developed H2O AI Super Agents platform for enterprise agentic AI capabilities.",
                    "constraints": [
                        ["Super Agents", "Super Agent"],
                        ["agentic", "Agentic"]
                    ]
                },
                {
                    "key": "gaia-benchmark",
                    "prompt": "What accuracy did H2O.ai achieve on the GAIA benchmark in 2025?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O.ai achieved 79.7% accuracy on the GAIA benchmark in June 2025.",
                    "constraints": [
                        ["79.7", "79.7%"],
                        ["GAIA", "benchmark"]
                    ]
                },
                {
                    "key": "super-agent",
                    "prompt": "What is H2O Superagent and what does it do?",
                    "categories": [
                        "question_answering"
                    ],
                    "expected_output": "H2O Superagent is a technology that converts complex business tasks into executable code, enabling precise and reliable automation with minimal hallucination.",
                    "constraints": [
                        ["Superagent", "superagent"],
                        ["code", "executable", "tasks"]
                    ]
                }
            ]
        }
    ]
}
