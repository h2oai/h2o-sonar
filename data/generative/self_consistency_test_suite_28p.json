{
    "name": "SR 11-7 Test Suite",
    "description": "SR 11-7 MRM document questions and answers.",
    "tests": [
        {
            "key": "29931e66-5a6c-4662-a188-eff55ec3665d",
            "documents": [
                "https://www.federalreserve.gov/supervisionreg/srletters/sr1107a1.pdf"
            ],
            "test_cases": [
                {
                    "key": "3d218d65-a2e6-4de4-af99-e93bd9132440",
                    "prompt": "What should validation reports include?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "executive summaries"
                    ],
                    "expected_output": "Validation reports should articulate model aspects that were reviewed, highlighting potential deficiencies over a range of financial and economic conditions, and determining whether adjustments or other compensating controls are warranted. They should also include clear executive summaries, with a statement of model purpose and an accessible synopsis of model and validation results, including major limitations and key assumptions."
                },
                {
                    "key": "85804363-a32f-452b-b58e-9b43578e25bd",
                    "prompt": "What is informed conservatism?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "judgment",
                        "experience"
                    ],
                    "expected_output": "Informed conservatism refers to a approach that involves using judgment and experience to make adjustments to model inputs or design, or to supplement model results with other analysis and information."
                },
                {
                    "key": "f55701bc-6071-4bc0-8c83-6abc8199c116",
                    "prompt": "What is the purpose of ongoing monitoring?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "evaluate",
                        "valid"
                    ],
                    "expected_output": "Ongoing monitoring is essential to evaluate whether changes in products, exposures, activities, clients, or market conditions necessitate adjustment, redevelopment, or replacement of the model and to verify that any extension of the model beyond its original scope is valid."
                },
                {
                    "key": "af27e87a-fbba-43c7-96db-32821cfba555",
                    "prompt": "How should banks approach model development?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "focus",
                        "risk management"
                    ],
                    "expected_output": "Banks should approach model development with a focus on sound risk management practices. They should ensure that models are developed and used in a controlled environment, with proper documentation, testing, and validation. They should also ensure that models are regularly reviewed and updated to reflect changing market conditions and business needs."
                },
                {
                    "key": "496908a0-7291-48de-8e1f-51d80f3b9332",
                    "prompt": "What is effective challenge of models?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "critical analysis"
                    ],
                    "expected_output": "Effective challenge of models refers to critical analysis by objective, informed parties who can identify model limitations and assumptions and produce appropriate changes."
                },
                {
                    "key": "df54fbd7-1de5-4858-86b8-ef13c11544f1",
                    "prompt": "Who should perform model validation?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "competence"
                    ],
                    "expected_output": "Model validation should be performed by staff with appropriate incentives, competence, and influence, who are not responsible for development or use of the model and do not have a stake in whether a model is determined to be valid."
                },
                {
                    "key": "35118a2b-7931-496c-afb2-5725c7509813",
                    "prompt": "What is the purpose of model validation?",
                    "categories": [
                        "question-answering"
                    ],
                    "condition": "",
                    "relationships": [],
                    "constraints": [
                        "sound",
                        "appropriate"
                    ],
                    "expected_output": "The purpose of model validation is to ensure that models are sound and appropriate for their intended use."
                },
